<Window x:Class="EverythingModern.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Everyview - Starting"
        Width="520" Height="295"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        Opacity="0.0"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WindowScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.96" To="1.0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="WindowScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.96" To="1.0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Effect>
        <DropShadowEffect BlurRadius="40" Direction="270" ShadowDepth="8" Color="#000000" Opacity="0.9" />
    </Window.Effect>

    <Border x:Name="RootBorder"
            RenderTransformOrigin="0.5,0.5"
            BorderThickness="1.2"
            CornerRadius="18"
            Padding="28,24"
            ClipToBounds="True">
        <Border.RenderTransform>
            <ScaleTransform x:Name="WindowScale" ScaleX="1.0" ScaleY="1.0" />
        </Border.RenderTransform>

        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D1017" Offset="0.0" />
                <GradientStop Color="#131722" Offset="0.5" />
                <GradientStop Color="#181E2B" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>

        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#38BDF8" Offset="0.0" />
                <GradientStop Color="#1E293B" Offset="0.5" />
                <GradientStop Color="#0284C7" Offset="1.0" />
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: Logo, Title, Version & Top-Right Close -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Glowing App Icon -->
                <Border Grid.Column="0"
                        Width="54" Height="54"
                        CornerRadius="14"
                        Background="#161C27"
                        BorderBrush="#293548"
                        BorderThickness="1.2"
                        Padding="5"
                        Margin="0,0,16,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#38BDF8" BlurRadius="12" Opacity="0.3" ShadowDepth="0" />
                    </Border.Effect>
                    <Image Source="Assets/app.png"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Everyview"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" />
                        <Border Background="#1E293B"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="7,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="v1.0" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Ultra-Fast Modern Windows Search Engine"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- Top Right Quick Dismiss Button -->
                <Button Grid.Column="2"
                        Click="CloseButton_Click"
                        Background="Transparent"
                        Foreground="#64748B"
                        BorderThickness="0"
                        Padding="6"
                        Cursor="Hand"
                        ToolTip="Skip splash and open Everyview immediately"
                        VerticalAlignment="Top">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="13" />
                </Button>
            </Grid>

            <!-- Center: Shimmer, Progress & Status Display -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18,0,14">
                <!-- Status Message with Pulsing Dot -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                    <Ellipse x:Name="PulseIndicator"
                             Width="9" Height="9"
                             Fill="#38BDF8"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1.0" To="0.3" Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <TextBlock x:Name="StatusTextBlock"
                               Text="Initializing Everyview Engine..."
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Modern Glowing Progress Bar -->
                <ProgressBar x:Name="ProgressBar"
                             IsIndeterminate="True"
                             Height="4"
                             Background="#161C26"
                             BorderThickness="0"
                             Margin="0,0,0,9">
                    <ProgressBar.Resources>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                                            <Grid x:Name="TemplateRoot">
                                                <Border x:Name="PART_Track" />
                                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#0284C7" Offset="0.0" />
                                                            <GradientStop Color="#38BDF8" Offset="0.6" />
                                                            <GradientStop Color="#7DD3FC" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ProgressBar.Resources>
                </ProgressBar>

                <!-- Detail / Sub-status Text -->
                <TextBlock x:Name="DetailTextBlock"
                           Text="Connecting to Voidtools Everything background service..."
                           FontSize="11.5"
                           Foreground="#64748B" />
            </StackPanel>

            <!-- Bottom Row: Help Tip & Open Now Button -->
            <DockPanel Grid.Row="2" Margin="0,4,0,0">
                <Button DockPanel.Dock="Right"
                        Content="Open Now ➔"
                        Click="OpenNowButton_Click"
                        Background="#1A2230"
                        Foreground="#94A3B8"
                        BorderBrush="#2D3B4F"
                        BorderThickness="1"
                        Padding="12,5"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        HorizontalAlignment="Right">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="⚡ Cold starts scan NTFS journals for microsecond search across all drives"
                           FontSize="10.5"
                           Foreground="#475569"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
